{
  "model": "qwen-plus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "existing-qwen-hook",
            "name": "keep"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "twn ai-hook --cli qwen",
